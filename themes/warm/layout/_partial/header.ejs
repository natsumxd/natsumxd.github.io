<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="<%- url_for('/') %>">
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-text" data-lang="zh"><%= theme.logo_text_zh %></span>
      <span class="brand-text" data-lang="en"><%= theme.logo_text_en %></span>
    </a>

    <nav class="site-nav" id="site-nav">
      <% (theme.menu || []).forEach(function (item) { %>
        <% var active = item.path === '/' ? is_home() : (page.path || '').indexOf(item.path.replace(/^\//, '')) === 0; %>
        <a class="nav-link<%= active ? ' is-active' : '' %>" href="<%- url_for(item.path) %>">
          <span data-lang="zh"><%= item.zh %></span>
          <span data-lang="en"><%= item.en %></span>
        </a>
      <% }); %>
    </nav>

    <div class="header-tools">
      <button class="icon-btn lang-btn" id="lang-toggle" type="button"
              aria-label="切换语言 / Switch language">
        <span class="lang-cur">中</span><span class="lang-sep">/</span><span class="lang-alt">EN</span>
      </button>
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换主题 / Toggle theme">
        <svg class="ico-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path d="M12 2.5v2.2M12 19.3v2.2M4.2 12H2M22 12h-2.2M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"></path>
        </svg>
        <svg class="ico-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5 8.7 8.7 0 1 0 20.5 14.6z"></path>
        </svg>
      </button>
      <button class="icon-btn nav-toggle" id="nav-toggle" type="button" aria-label="菜单 / Menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
